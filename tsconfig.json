{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Node",

    "strict": false,
    "allowJs": true,
    "checkJs": false,

    "jsx": "react-jsx",
    "isolatedModules": true,
    "noEmit": true,

    "skipLibCheck": true
  },
  "include": ["assets/src/**/*"]
}
