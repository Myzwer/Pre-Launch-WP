###
# PhpStorm / JetBrains IDE
# --------------------------------------------------
# We ignore all IDE state by default, but explicitly
# allow committing shared project-level defaults
# (code style + inspection profiles).
###

# Ignore everything in .idea by default
.idea/*

# Allow shared PhpStorm project defaults
!.idea/codeStyles/
!.idea/codeStyles/**
!.idea/inspectionProfiles/
!.idea/inspectionProfiles/**

# Never commit machine- or user-specific IDE state
.idea/workspace.xml          # window layout, open files, recent state
.idea/tasks.xml              # local task tracking
.idea/usage.statistics.xml   # IDE usage stats
.idea/deployment.xml         # server / deployment mappings
.idea/dataSources/           # database connections
.idea/dataSources.local.xml  # local DB config
.idea/shelf/                 # shelved changes
.idea/httpRequests/          # local HTTP client scratch files


###
# Build Output / Generated Assets
# --------------------------------------------------
# These are compiled artifacts and caches that should
# never be committed.
###

/assets/public
.cache/
node_modules
/vendor/
.cache/php-cs-fixer/


###
# OS / Editor Noise
# --------------------------------------------------
# Files generated by the operating system or editor
# that are never relevant to the repo.
###

.DS_Store


###
# Fonts
# --------------------------------------------------
# Fonts are typically generated or pulled from a
# design system / CDN and should not be versioned.
###

*.woff
*.woff2


###
# Environment Variables
# --------------------------------------------------
# Environment-specific secrets and overrides.
###

.env
.env.local
.env.*.local


###
# Package Manager / Tooling
# --------------------------------------------------
# Yarn Berry / PnP and related tooling artifacts.
###

.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
