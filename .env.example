# ------------------------------------------------------------------------------
# ENVIRONMENT SETUP (DEV ONLY)
# ------------------------------------------------------------------------------
# This file documents the available environment variables for local development.
#
# To use:
# 1. Copy this file to `.env.local`
# 2. Update the values to match your Local site
# 3. Run `yarn dev`
#
# NOTE:
# - `.env.local` is ignored by git and should NOT be committed
# - If no `.env.local` exists, Webpack will fall back to safe defaults
# ------------------------------------------------------------------------------

# BrowserSync
# ------------------------------------------------------------------------------
# The local URL created by Local (or similar tooling)
BROWSERSYNC_PROXY=https://prelaunch.local

# BrowserSync host + port (change only if needed)
BROWSERSYNC_HOST=localhost
BROWSERSYNC_PORT=3000

# Files that trigger BrowserSync reloads
# Default watches all PHP files in the theme
BROWSERSYNC_FILES=**/**/**.php
